# CONFIG_BRINGUP_HC05 is not set
# CONFIG_BRINGUP_USB_ENUM is not set
# CONFIG_BRINGUP_PL2303_ECHO is not set
CONFIG_BRINGUP_BRIDGE=y
CONFIG_PL2303_TEST_BAUD=9600
CONFIG_PL2303_TEST_CONTROL_LINES=0
CONFIG_HC05_BAUD=115200
CONFIG_HC05_TX_GPIO=17
CONFIG_HC05_RX_GPIO=16
CONFIG_HC05_STATE_GPIO=18
CONFIG_BRIDGE_STARTUP_MS=10000
# CONFIG_BRIDGE_TRACE_HEX is not set
